[Unit]
Description=Zangetsu KLIPY API proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zangetsu-klipy
Group=zangetsu-klipy
SupplementaryGroups=sync_authenticator
WorkingDirectory=/opt/zangetsu-klipy
Environment=SUPABASE_ISSUER=https://eogwzrlfoercfwcfwlmv.supabase.co/auth/v1
Environment=SUPABASE_JWKS_PATH=/etc/zangetsu-sync/jwks.json
LoadCredential=klipy_api_key:/etc/zangetsu-klipy/api_key
ExecStart=/opt/zangetsu-klipy/venv/bin/python /opt/zangetsu-klipy/klipy_proxy.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
